{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${authors}"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "darkorg.betterdurability.fabric.BetterDurabilityFabric"
    ],
    "client": [
      "darkorg.betterdurability.fabric.BetterDurabilityFabricClient"
    ],
    "server": [
      "darkorg.betterdurability.fabric.BetterDurabilityFabricServer"
    ],
    "fabric-datagen": [
      "darkorg.betterdurability.fabric.BetterDurabilityFabricDataGenerator"
    ]
  },
  "mixins": [
    "${mod_id}.common.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "accessWidener": "betterdurability.accesswidener",
  "depends": {
    "java": ">=17",
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "forgeconfigapiport": ">=${fcap_version}"
  },
  "suggests": {
    "another-mod": "*"
  }
}